# === GivSelf Configuration ===

# Database (required)
DB_PASSWORD=changeme

# Inverter (required — your inverter's IP on the local network)
INVERTER_HOST=192.168.1.100

# WebSocket host (required — your Docker host's LAN IP, for browser WebSocket connections)
WS_HOST=192.168.1.50

# Ports (optional — change if defaults conflict with other services)
# SERVER_PORT=3032
# WEB_PORT=3033

# Advanced (optional — defaults are fine for most users)
# DB_NAME=givself
# DB_USER=givself
# ADAPTER_TYPE=givenergy
# POLL_INTERVAL_MS=10000

# All other settings (API keys, serials, solar config) are configured
# through the web UI at http://your-server:3033/settings
