# === GivSelf Unraid Configuration ===

# Database
DB_NAME=givself
DB_USER=givself
DB_PASSWORD=changeme_to_something_secure

# Data path (Unraid appdata)
DATA_PATH=/mnt/user/appdata/givself

# Inverter (REQUIRED — your inverter's IP on the local network)
INVERTER_HOST=192.168.1.100
ADAPTER_TYPE=givenergy
POLL_INTERVAL_MS=10000

# GivEnergy Cloud API (optional — enables historical data import + system info)
# Get your API key from https://givenergy.cloud → API Tokens
GIVENERGY_API_KEY=
GIVENERGY_INVERTER_SERIAL=

# Solcast Solar Forecast (optional — enables solar generation forecasting)
# Get your API key from https://toolkit.solcast.com.au
SOLCAST_API_KEY=
SOLCAST_SITE_ID=
